<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>IVRSC</title><style>*{box-sizing:border-box}body{margin:0;background:#f5f6f5;color:#111;font-family:Arial,sans-serif;padding-bottom:95px}button,input,textarea{font:inherit}button{cursor:pointer}header{height:60px;background:#fff;border-bottom:1px solid #ddd;display:flex;align-items:center;justify-content:space-between;padding:0 15px;position:sticky;top:0;z-index:20}.logo{font-size:25px;font-weight:900;color:#19a34a}.page{display:none;max-width:700px;margin:auto;padding:14px}.page.active{display:block}.tabs{display:flex;gap:6px;background:#fff;padding:5px;border-radius:15px;margin-bottom:14px}.tabs button{flex:1;border:0;background:none;padding:10px;border-radius:11px;font-weight:bold}.tabs button.active{background:#e5f5e9;color:#16833b}.card{background:#fff;border:1px solid #ddd;border-radius:18px;overflow:hidden;margin-bottom:14px}.head{display:flex;align-items:center;gap:10px;padding:12px}.avatar{width:42px;height:42px;border-radius:50%;object-fit:cover;background:#ddd}.media{width:100%;max-height:600px;object-fit:cover;display:block}.text{padding:12px;line-height:1.4}.actions{display:flex;gap:7px;padding:10px 12px}.action{border:0;background:#f2f2f2;border-radius:11px;padding:8px 12px}.liked{color:#16833b;background:#e5f5e9}.empty{background:#fff;border:1px solid #ddd;border-radius:18px;text-align:center;padding:40px 15px}.green{background:#19a34a;color:#fff;border:0;border-radius:12px;padding:10px 16px;font-weight:bold}.outline{background:#fff;color:#16833b;border:1px solid #19a34a;border-radius:12px;padding:10px 16px;font-weight:bold}.cover{height:160px;border-radius:20px;background:linear-gradient(135deg,#19a34a,#9ad8aa);overflow:hidden}.cover img{width:100%;height:100%;object-fit:cover}.profile{background:#fff;border-radius:20px;margin-top:-30px;padding:0 15px 18px;position:relative}.pavatar{width:85px;height:85px;border-radius:50%;object-fit:cover;border:4px solid #fff;margin-top:-42px;background:#ddd}.stats{display:flex;gap:25px;margin:15px 0}.stats div{text-align:center}.stats b{display:block}.stats small{color:#666}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:3px;margin-top:12px}.grid div{aspect-ratio:1;background:#ddd;overflow:hidden}.grid img,.grid video{width:100%;height:100%;object-fit:cover}.modal{position:fixed;inset:0;background:#0008;display:none;align-items:center;justify-content:center;padding:15px;z-index:100}.modal.open{display:flex}.box{background:#fff;width:min(100%,520px);max-height:90vh;overflow:auto;padding:20px;border-radius:20px}.field{margin-bottom:12px}.field label{display:block;font-weight:bold;margin-bottom:5px}.field input,.field textarea{width:100%;padding:10px;border:1px solid #ccc;border-radius:11px}.field textarea{min-height:110px;resize:vertical}.bottom{position:fixed;bottom:10px;left:50%;transform:translateX(-50%);width:min(96vw,560px);height:68px;background:#fffffff7;border:1px solid #ddd;border-radius:23px;box-shadow:0 8px 30px #0002;padding:6px;display:grid;grid-template-columns:1fr 1fr 1.1fr 1fr 1fr;gap:5px;z-index:90}.nav{border:0;background:transparent;border-radius:16px;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:11px;font-weight:bold}.nav.active{background:#e5f5e9;color:#16833b}.icon{font-size:21px}.create{width:52px;height:52px;align-self:center;justify-self:center;border-radius:17px;background:#19a34a;color:#fff;font-size:30px}.community{background:#fff;border:1px solid #ddd;border-radius:17px;padding:15px;margin-bottom:10px}@media(max-width:390px){.bottom{width:97vw}.nav{font-size:10px}}</style></head><body><header> <div class="logo">IVRSC</div> <button class="outline" onclick="openEdit()">Perfil</button></header><section id="home" class="page active"> <div class="tabs"> <button class="active">Para Ti</button> <button onclick="alert('La sección Siguiendo estará disponible próximamente.')">Siguiendo</button> </div> <div id="feed"></div></section><section id="reels" class="page"> <h2>Reels</h2> <div id="reelsBox"></div></section><section id="community" class="page"> <div style="display:flex;justify-content:space-between;align-items:center"> <h2>Comunidad</h2> <button class="green" onclick="newCommunity()">Crear</button> </div> <div id="communities"></div></section><section id="profile" class="page"> <div class="cover" id="cover"></div> <div class="profile"> <img id="pavatar" class="pavatar"> <h2 id="pname">Usuario</h2> <p id="pbio">Bienvenido a IVRSC.</p> <div class="stats"> <div><b id="posts">0</b><small>Publicaciones</small></div> <div><b id="followers">0</b><small>Seguidores</small></div> <div><b id="following">0</b><small>Siguiendo</small></div> </div> <button class="green" onclick="openEdit()">Editar perfil</button> <button class="outline" onclick="openCreate()">Publicar</button> </div> <div id="grid" class="grid"></div></section><nav class="bottom"> <button class="nav active" data-page="home"><span class="icon">⌂</span>Para Ti</button> <button class="nav" data-page="reels"><span class="icon">▶</span>Reels</button> <button class="nav create" onclick="openCreate()">+</button> <button class="nav" data-page="community"><span class="icon">♧</span>Comunidad</button> <button class="nav" data-page="profile"><span class="icon">●</span>Perfil</button></nav><div id="create" class="modal"><div class="box"><h2>Crear publicación</h2><div class="field"><label>Descripción</label><textarea id="desc" placeholder="¿Qué quieres compartir?"></textarea></div><div class="field"><label>Imagen o video</label><input id="file" type="file" accept="image/*,video/*"></div><button class="outline" onclick="closeModal('create')">Cancelar</button><button class="green" onclick="publish()">Publicar</button></div></div><div id="edit" class="modal"><div class="box"><h2>Personalizar perfil</h2><div class="field"><label>Nombre</label><input id="name"></div><div class="field"><label>Biografía</label><textarea id="bio"></textarea></div><div class="field"><label>Foto de perfil</label><input id="avatarFile" type="file" accept="image/*"></div><div class="field"><label>Portada</label><input id="coverFile" type="file" accept="image/*"></div><button class="outline" onclick="closeModal('edit')">Cancelar</button><button class="green" onclick="saveProfile()">Guardar</button></div></div><script>const KEY="IVRSC_DATA";let data={ profile:{ name:"Usuario", bio:"Bienvenido a IVRSC.", avatar:"", cover:"", followers:0, following:0 }, posts:[], communities:[]};function load(){ try{ const x=localStorage.getItem(KEY); if(x)data={...data,...JSON.parse(x)}; }catch(e){}}function save(){ try{ localStorage.setItem(KEY,JSON.stringify(data)); }catch(e){ alert("No se pudo guardar. El archivo puede ser demasiado grande."); }}function page(id){ document.querySelectorAll(".page").forEach(x=>x.classList.toggle("active",x.id===id)); document.querySelectorAll(".nav[data-page]").forEach(x=>x.classList.toggle("active",x.dataset.page===id)); render();}document.querySelectorAll(".nav[data-page]").forEach(x=>{ x.onclick=()=>page(x.dataset.page);});function openModal(id){ document.getElementById(id).classList.add("open");}function closeModal(id){ document.getElementById(id).classList.remove("open");}function openCreate(){ document.getElementById("desc").value=""; document.getElementById("file").value=""; openModal("create");}function publish(){ const desc=document.getElementById("desc").value.trim(); const file=document.getElementById("file").files[0]; if(!desc&&!file){ alert("Escribe algo o selecciona un archivo."); return; } if(file && file.size>45*1024*1024){ alert("El archivo supera el límite de 45 MB."); return; } const post={ id:Date.now(), text:desc, media:"", type:"", likes:0, liked:false }; if(file){ const reader=new FileReader(); reader.onload=()=>{ post.media=reader.result; post.type=file.type.startsWith("video/")?"video":"image"; data.posts.unshift(post); save(); closeModal("create"); render(); }; reader.readAsDataURL(file); }else{ data.posts.unshift(post); save(); closeModal("create"); render(); }}function postHTML(p){ let media=""; if(p.media){ media=p.type==="video" ?`<video class="media" src="${p.media}" controls></video>` :`<img class="media" src="${p.media}">`; } return ` <article class="card"> <div class="head"> <img class="avatar" src="${data.profile.avatar||avatarDefault()}"> <div><b>${esc(data.profile.name)}</b><br><small>@${user()}</small></div> </div> ${media} ${p.text?`<div class="text">${esc(p.text)}</div>`:""} <div class="actions"> <button class="action ${p.liked?"liked":""}" onclick="like(${p.id})"> ${p.liked?"♥":"♡"} ${p.likes} </button> <button class="action" onclick="alert('Comentarios próximamente.')">💬</button> <button class="action" onclick="share()">↗</button> </div> </article>`;}function renderFeed(){ const box=document.getElementById("feed"); if(!data.posts.length){ box.innerHTML=` <div class="empty"> <h3>No hay publicaciones</h3> <p>Crea la primera publicación de IVRSC.</p> <button class="green" onclick="openCreate()">Crear publicación</button> </div>`; return; } box.innerHTML=data.posts.map(postHTML).join("");}function like(id){ const p=data.posts.find(x=>x.id===id); if(!p)return; p.liked=!p.liked; p.likes+=p.liked?1:-1; save(); renderFeed();}function share(){ if(navigator.share){ navigator.share({ title:"IVRSC", text:"Mira esta publicación de IVRSC." }).catch(()=>{}); }else{ alert("Puedes compartir IVRSC desde el menú de tu navegador."); }}function renderReels(){ const box=document.getElementById("reelsBox"); const videos=data.posts.filter(x=>x.type==="video"); if(!videos.length){ box.innerHTML=` <div class="empty"> <h3>No hay Reels todavía</h3> <p>Los videos que publiques aparecerán aquí.</p> <button class="green" onclick="openCreate()">Crear Reel</button> </div>`; return; } box.innerHTML=videos.map(postHTML).join("");}function openEdit(){ document.getElementById("name").value=data.profile.name; document.getElementById("bio").value=data.profile.bio; document.getElementById("avatarFile").value=""; document.getElementById("coverFile").value=""; openModal("edit");}function saveProfile(){ data.profile.name= document.getElementById("name").value.trim()||"Usuario"; data.profile.bio= document.getElementById("bio").value.trim(); const af=document.getElementById("avatarFile").files[0]; const cf=document.getElementById("coverFile").files[0]; let files=0; if(af)files++; if(cf)files++; function done(){ files--; if(files<=0){ save(); closeModal("edit"); render(); } } if(af){ const r=new FileReader(); r.onload=()=>{ data.profile.avatar=r.result; done(); }; r.readAsDataURL(af); } if(cf){ const r=new FileReader(); r.onload=()=>{ data.profile.cover=r.result; done(); }; r.readAsDataURL(cf); } if(!files){ save(); closeModal("edit"); render(); }}function renderProfile(){ document.getElementById("pname").textContent=data.profile.name; document.getElementById("pbio").textContent=data.profile.bio; document.getElementById("posts").textContent=data.posts.length; document.getElementById("followers").textContent=data.profile.followers; document.getElementById("following").textContent=data.profile.following; document.getElementById("pavatar").src= data.profile.avatar||avatarDefault(); const cover=document.getElementById("cover"); cover.innerHTML=data.profile.cover ?`<img src="${data.profile.cover}">` :""; document.getElementById("grid").innerHTML= data.posts.filter(x=>x.media).map(x=> x.type==="video" ?`<div><video src="${x.media}" muted></video></div>` :`<div><img src="${x.media}"></div>` ).join("");}function newCommunity(){ const name=prompt("Nombre de la comunidad:"); if(!name||!name.trim())return; data.communities.push({ id:Date.now(), name:name.trim(), members:1 }); save(); renderCommunities();}function renderCommunities(){ const box=document.getElementById("communities"); if(!data.communities.length){ box.innerHTML=` <div class="empty"> <h3>No hay comunidades</h3> <p>Crea la primera comunidad.</p> <button class="green" onclick="newCommunity()">Crear comunidad</button> </div>`; return; } box.innerHTML=data.communities.map(c=>` <div class="community"> <h3>${esc(c.name)}</h3> <p>${c.members} miembro${c.members===1?"":"s"}</p> <button class="outline" onclick="join(${c.id})">Unirse</button> </div>`).join("");}function join(id){ const c=data.communities.find(x=>x.id===id); if(!c)return; c.members++; save(); renderCommunities(); alert("Te uniste a la comunidad.");}function render(){ renderFeed(); renderReels(); renderCommunities(); renderProfile();}function user(){ return data.profile.name .toLowerCase() .replace(/[^a-z0-9áéíóúñ ]/gi,"") .trim() .replace(/\s+/g,"_")||"usuario";}function esc(x){ return String(x) .replace(/&/g,"&amp;") .replace(/</g,"&lt;") .replace(/>/g,"&gt;") .replace(/"/g,"&quot;") .replace(/'/g,"'");}function avatarDefault(){ return "data:image/svg+xml;charset=UTF-8,"+ encodeURIComponent(` <svg xmlns="http://www.w3.org/2000/svg" width="100" height="100"> <rect width="100" height="100" fill="#dfe5e1"/> <circle cx="50" cy="38" r="20" fill="#99a59d"/> <circle cx="50" cy="105" r="38" fill="#99a59d"/> </svg>`);}load();render();</script></body></html>
